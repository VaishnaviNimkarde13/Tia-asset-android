    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "scheme": "nurse-login-scan-app",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-barcode-scanner",
